# API base URL (including /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Multi-studio: each studio is served at <slug>.<NEXT_PUBLIC_BASE_DOMAIN>.
# The bare domain shows the platform sign-in.
NEXT_PUBLIC_BASE_DOMAIN=

# Single-studio deployments (or local development): the studio slug to show.
NEXT_PUBLIC_DEFAULT_STUDIO=
